        "properties": {
          "nodeId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "chunksOnNode": {
            "type": "integer",
            "format": "int32"
          },
          "replicaRows": {
            "type": "integer",
            "format": "int32"
          },
          "orphans": {
            "type": "integer",
            "format": "int32"
          },
          "orphanSample": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing": {
            "type": "integer",
            "format": "int32"
          },
          "missingSample": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "orphansDeleted": {
