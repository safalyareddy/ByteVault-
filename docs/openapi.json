          "sizeBytes"
        ]
      },
      "UploadView": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "format": "uuid"
          },
          "objectId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "objectStatus": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "chunkSizeBytes": {
            "type": "integer",
            "format": "int32"
          },
          "chunkCount": {
            "type": "integer",
            "format": "int32"
          },
          "replicationFactor": {
            "type": "integer",
            "format": "int32"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "storedChunks": {
            "type": "integer",
            "format": "int32"
          },
          "missingChunkIndexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "CompleteResult": {
        "type": "object",
        "properties": {
          "objectId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "chunkCount": {
            "type": "integer",
            "format": "int32"
          },
          "replicationFactor": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DrainRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          }
        },
        "required": [
          "reason"
        ]
      },
      "DrainStatus": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "verifiedReplicas": {
            "type": "integer",
            "format": "int32"
          },
          "replicasPendingDeletion": {
            "type": "integer",
            "format": "int32"
          },
          "chunksStillDependingOnNode": {
            "type": "integer",
            "format": "int32"
          },
          "safeToRemove": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ]
          }
        },
        "required": [
          "password",
          "role",
          "username"
        ]
      },
      "ScrubSummary": {
        "type": "object",
        "properties": {
          "checked": {
            "type": "integer",
            "format": "int32"
          },
          "intact": {
            "type": "integer",
            "format": "int32"
          },
