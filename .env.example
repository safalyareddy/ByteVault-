# Copy to .env (git-ignored), or run scripts/gen-env.sh to create one with random secrets.
# Never commit .env. All values below are placeholders.

# --- PostgreSQL (authoritative metadata) ---
DATABASE_USERNAME=bytevault
DATABASE_PASSWORD=change-me
BV_POSTGRES_HOST_PORT=55432

# --- Kafka ---
BV_KAFKA_HOST_PORT=9092

# --- Control plane ---
BV_BACKEND_HOST_PORT=8090
BV_CHUNK_SIZE_BYTES=4194304          # 4 MiB (ADR-0003); allowed 65536..67108864
BV_REPLICATION_FACTOR=3              # never lowered silently (ADR-0005)
BV_MAX_UPLOAD_BYTES=1073741824       # 1 GiB per object
BV_HEARTBEAT_INTERVAL=5s
BV_SUSPECT_AFTER=15s                 # must be > heartbeat interval
BV_OFFLINE_AFTER=45s                 # must be > suspect-after
BV_SCRUB_INTERVAL=10m
BV_MAX_CONCURRENT_CHUNK_TRANSFERS=8   # bounds spool disk use to N x chunk size

# --- Authentication: creates ADMIN 'admin' on first start only (>= 12 chars). Log in with scripts/bv.sh login
BV_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- Storage nodes: one secret per node, >= 32 chars (openssl rand -hex 32) ---
BV_NODE_1_SECRET=change-me-to-a-random-64-hex-char-secret-node-1
BV_NODE_2_SECRET=change-me-to-a-random-64-hex-char-secret-node-2
BV_NODE_3_SECRET=change-me-to-a-random-64-hex-char-secret-node-3
BV_NODE_4_SECRET=change-me-to-a-random-64-hex-char-secret-node-4   # spare node (profile "spare")
BV_NODE_MAX_CHUNK_BYTES=67108864

# --- Optional monitoring profile ---
GRAFANA_ADMIN_PASSWORD=change-me
